RewriteEngine On

# non-www 및 HTTP 접속을 SSL 인증서 CN(www.leadingpoint.co.kr)으로 통합 리다이렉트
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^leadingpoint\.co\.kr$ [NC]
RewriteRule ^(.*)$ https://www.leadingpoint.co.kr/$1 [R=301,L]

# data.json 캐시 방지
<IfModule mod_headers.c>
  <Files "data.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>

# .git 외부 접근 차단 (.htaccess 표준 Rewrite 방식)
RewriteRule ^\.git(/|$) - [F,L]

# 내부 위키(Obsidian 보관함) 외부 접근 차단
RewriteRule ^LeadingPoint_Homepage(/|$) - [F,L]
